# Managed-By: xingxingzaishan-object-mirror
[Unit]
Description=Run Xingxingzaishan full object restore audit monthly

[Timer]
OnCalendar=*-*-01 04:20:00 Asia/Shanghai
Persistent=true
AccuracySec=5min
RandomizedDelaySec=15min
Unit=xingxingzaishan-object-mirror-full-audit.service

[Install]
WantedBy=timers.target
