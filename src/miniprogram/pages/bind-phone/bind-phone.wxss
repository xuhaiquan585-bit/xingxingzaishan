.bind-phone-page {
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 96rpx 44rpx calc(72rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(
      circle at 90% 6%,
      rgba(255, 243, 216, .16) 0%,
      rgba(255, 243, 216, .05) 24%,
      rgba(255, 243, 216, 0) 44%
    ),
    linear-gradient(
      180deg,
      #D8E4EA 0%,
      #E8EEF0 38%,
      #F0F1ED 70%,
      #F5F1E9 100%
    );
  color: #223147;
}

.bind-phone-page::before,
.bind-phone-page::after {
  display: none;
}

.bind-brand {
  margin: 0 0 42rpx;
  text-align: left;
}

.bind-brand-mark {
  display: none;
}

.bind-phone-page .hero-title {
  max-width: 100%;
  margin: 0 0 16rpx;
  color: #223147;
  font-size: 44rpx;
  font-weight: 650;
  line-height: 1.34;
  text-align: left;
}

.bind-phone-page .subtitle {
  max-width: 100%;
  margin: 0;
  color: #68798A;
  font-size: 27rpx;
  line-height: 1.62;
  text-align: left;
}

.bind-subtitle {
  white-space: pre-line;
}

.bind-login-card {
  box-sizing: border-box;
  width: 100%;
  margin: 0;
  padding: 30rpx 28rpx 32rpx;
  border: 1rpx solid rgba(52, 72, 91, .12);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, .62);
  box-shadow: none;
  -webkit-backdrop-filter: none;
  backdrop-filter: none;
}

.bind-login-card .list-title {
  margin: 0 0 10rpx;
  color: #223147;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.38;
}

.bind-login-card .hint {
  margin: 0;
  color: #526576;
  font-size: 25rpx;
  line-height: 1.62;
}

.wechat-login-btn {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 100rpx;
  margin: 42rpx 0 0;
  padding: 0 36rpx;
  border-radius: 16rpx;
  background: #C79E55;
  color: #162230;
  font-size: 30rpx;
  font-weight: 650;
  line-height: 1;
  white-space: nowrap;
  box-shadow: none;
}

.wechat-login-btn::after {
  border: 0;
}

.wechat-login-btn[disabled] {
  background: rgba(199, 158, 85, .38);
  color: rgba(22, 34, 48, .52);
  opacity: 1;
}

.wechat-mark {
  flex: 0 0 auto;
  margin-right: 14rpx;
  color: #162230;
  font-weight: 750;
  white-space: nowrap;
}

.wechat-login-text {
  flex: 0 0 auto;
  color: #162230;
  white-space: nowrap;
}

.sms-fallback-btn {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 84rpx;
  margin: 22rpx 0 0;
  padding: 0 32rpx;
  border: 1rpx solid rgba(168, 137, 85, .24);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, .28);
  color: #A88955;
  font-size: 27rpx;
  font-weight: 500;
  line-height: 1;
  box-shadow: none;
}

.sms-fallback-btn::after {
  border: 0;
}

.sms-fallback-btn[disabled] {
  color: #8493A1;
  opacity: 1;
}

.meta {
  box-sizing: border-box;
  margin: 24rpx 0 0;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(164, 95, 88, .16);
  border-radius: 16rpx;
  background: rgba(164, 95, 88, .06);
  color: #A45F59;
  font-size: 24rpx;
  line-height: 1.58;
  text-align: left;
}
