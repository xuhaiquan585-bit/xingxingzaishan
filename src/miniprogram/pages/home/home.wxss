.home-page {
  min-height: 100vh;
  padding: 20rpx 0 calc(128rpx + env(safe-area-inset-bottom));
  background: #f6f5f1;
  color: #142844;
  box-sizing: border-box;
  overflow: hidden;
}

.home-page::before,
.home-page::after {
  display: none;
}

.home-hero {
  position: relative;
  min-height: 890rpx;
  margin: 0 20rpx 54rpx;
  overflow: hidden;
  border-radius: 16rpx;
  background: #e8eff1;
}

.home-hero-image,
.home-hero-fallback,
.home-hero-overlay {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.home-hero-image {
  display: block;
}

.home-hero-fallback {
  background: #e8efed;
}

.home-hero-overlay {
  background: linear-gradient(
    105deg,
    rgba(246, 245, 241, .97) 0%,
    rgba(246, 245, 241, .88) 44%,
    rgba(246, 245, 241, .28) 72%,
    rgba(246, 245, 241, .04) 100%
  );
}

.home-hero-content {
  position: relative;
  z-index: 1;
  box-sizing: border-box;
  min-height: 890rpx;
  padding: 32rpx 28rpx 34rpx;
}

.home-brand-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.home-brand-wrap {
  flex: 0 0 54rpx;
  width: 54rpx;
  height: 54rpx;
}

.home-logo,
.home-brand-mark {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
}

.home-logo {
  display: block;
  background: rgba(255, 255, 255, .76);
}

.home-brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(200, 156, 76, .32);
  background: rgba(255, 255, 255, .78);
  color: #b98b3d;
  box-sizing: border-box;
}

.home-brand-star {
  font-size: 38rpx;
  line-height: 1;
}

.home-brand-copy {
  min-width: 0;
}

.home-brand-name {
  color: #142844;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.2;
}

.home-brand-subtitle {
  margin-top: 3rpx;
  color: #68788c;
  font-size: 19rpx;
  line-height: 1.2;
}

.home-hero-copy {
  width: 440rpx;
  margin-top: 74rpx;
}

.home-page .hero-title {
  max-width: 440rpx;
  margin: 0 0 22rpx;
  color: #142844;
  font-family: "Songti SC", STSong, serif;
  font-size: 54rpx;
  font-weight: 700;
  line-height: 1.24;
  letter-spacing: 0;
  text-align: left;
  white-space: pre-line;
  word-break: keep-all;
  overflow-wrap: normal;
}

.home-page .subtitle,
.home-hero-subtitle {
  max-width: 410rpx;
  margin: 0;
  color: #526576;
  font-size: 26rpx;
  line-height: 1.62;
  text-align: left;
  white-space: pre-line;
}

.home-hero-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  width: 384rpx;
  margin-top: 34rpx;
}

.home-page .home-primary-cta,
.home-page .home-scan-link {
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.2;
  box-shadow: none;
}

.home-page .home-primary-cta {
  border: 1rpx solid rgba(180, 134, 56, .32);
  background: #d6a649;
  color: #142844;
}

.home-page .home-scan-link {
  border: 1rpx solid rgba(20, 40, 68, .16);
  background: rgba(255, 255, 255, .9);
  color: #263445;
}

.home-page .home-primary-cta::after,
.home-page .home-scan-link::after {
  border: 0;
}

.home-hero-note {
  margin-top: 18rpx;
  color: #526576;
  font-size: 21rpx;
  line-height: 1.45;
}

.home-section {
  position: relative;
  margin-bottom: 54rpx;
}

.home-section-title {
  margin: 0 28rpx 22rpx;
  color: #142844;
  font-family: "Songti SC", STSong, serif;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.36;
}

.home-section-caption {
  margin: -12rpx 28rpx 18rpx;
  color: #8b969f;
  font-size: 20rpx;
  line-height: 1.4;
}

.home-steps-section {
  margin: 0 20rpx 58rpx;
  padding: 34rpx 8rpx 38rpx;
  border-radius: 16rpx;
  background: #e8eff1;
}

.home-steps-section .home-section-title {
  margin-left: 20rpx;
  margin-right: 20rpx;
}

.home-steps {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 24rpx minmax(0, 1fr) 24rpx minmax(0, 1fr);
  align-items: start;
  gap: 4rpx;
}

.home-step {
  min-width: 0;
  text-align: center;
}

.home-step-index {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 6rpx;
  border-radius: 999rpx;
  background: #c89c4c;
  color: #fff;
  font-size: 17rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.home-step-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  margin: 12rpx auto 12rpx;
  border: 1rpx solid rgba(20, 40, 68, .1);
  border-radius: 50%;
  background: rgba(255, 255, 255, .72);
  color: #142844;
  font-size: 26rpx;
  font-weight: 700;
}

.home-step-title {
  color: #142844;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.3;
}

.home-step-desc {
  margin-top: 8rpx;
  padding: 0 4rpx;
  color: #68788c;
  font-size: 20rpx;
  line-height: 1.45;
}

.home-step-connector {
  height: 1rpx;
  margin-top: 62rpx;
  background: rgba(20, 40, 68, .18);
}

.home-scene-scroll,
.home-memory-scroll {
  width: 100%;
  white-space: nowrap;
}

.home-scene-list,
.home-memory-list {
  display: flex;
  gap: 18rpx;
  padding: 0 28rpx;
}

.home-scene-card {
  display: inline-flex;
  flex: 0 0 266rpx;
  width: 266rpx;
  flex-direction: column;
  overflow: hidden;
  border: 1rpx solid #e1e4e3;
  border-radius: 16rpx;
  background: #fff;
  white-space: normal;
}

.home-scene-image,
.home-scene-fallback {
  width: 266rpx;
  height: 150rpx;
}

.home-scene-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eef2ef;
}

.home-scene-symbol {
  color: #c89c4c;
  font-size: 48rpx;
}

.home-scene-copy {
  min-width: 0;
  padding: 18rpx;
}

.home-scene-title {
  color: #142844;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.3;
}

.home-scene-desc {
  margin-top: 8rpx;
  color: #68788c;
  font-size: 22rpx;
  line-height: 1.48;
}

.home-scene-action {
  margin-top: 14rpx;
  color: #a77d37;
  font-size: 21rpx;
  font-weight: 700;
}

.home-memory-card {
  display: inline-flex;
  flex: 0 0 430rpx;
  width: 430rpx;
  min-height: 166rpx;
  overflow: hidden;
  border: 1rpx solid #e1e4e3;
  border-radius: 16rpx;
  background: #fff;
  white-space: normal;
}

.home-slide-image,
.home-slide-fallback,
.home-memory-image,
.home-memory-fallback {
  flex: 0 0 136rpx;
  width: 136rpx;
  min-height: 166rpx;
}

.home-slide-fallback,
.home-memory-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #efe7d9;
}

.home-slide-symbol {
  color: #c89c4c;
  font-size: 42rpx;
}

.home-memory-copy {
  min-width: 0;
  padding: 18rpx;
}

.home-memory-title {
  color: #142844;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.38;
}

.home-memory-desc {
  margin-top: 8rpx;
  color: #68788c;
  font-size: 21rpx;
  line-height: 1.48;
}

.home-memory-action {
  margin-top: 11rpx;
  color: #a77d37;
  font-size: 20rpx;
  font-weight: 700;
}

.home-trust-section {
  margin: 0 28rpx;
  padding-top: 34rpx;
  border-top: 1rpx solid #e1e4e3;
}

.home-trust-section .home-section-title {
  margin-left: 0;
  margin-right: 0;
}

.home-trust-list {
  border-top: 1rpx solid #e1e4e3;
}

.home-trust-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 104rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #e1e4e3;
  box-sizing: border-box;
}

.home-trust-icon {
  display: flex;
  flex: 0 0 58rpx;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border: 1rpx solid rgba(200, 156, 76, .32);
  border-radius: 50%;
  color: #a77d37;
  font-size: 22rpx;
  font-weight: 700;
}

.home-trust-copy {
  min-width: 0;
}

.home-trust-label {
  color: #142844;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.35;
}

.home-trust-desc {
  margin-top: 4rpx;
  color: #68788c;
  font-size: 21rpx;
  line-height: 1.42;
}

@media (max-width: 340px) {
  .home-hero-copy {
    width: 400rpx;
  }

  .home-page .hero-title {
    max-width: 400rpx;
  }

  .home-hero-actions {
    width: 360rpx;
  }

  .home-step-desc {
    font-size: 19rpx;
  }
}
