<view class="page home-page">
  <view class="home-hero">
    <image
      wx:if="{{hasBanner}}"
      class="home-hero-image"
      mode="aspectFill"
      src="{{bannerImage}}"
      binderror="onBannerError"
    />
    <view wx:else class="home-hero-fallback"></view>
    <view class="home-hero-overlay"></view>

    <view class="home-hero-content">
      <view class="home-brand-row">
        <view class="home-brand-wrap">
          <image wx:if="{{hasLogo}}" class="home-logo" mode="aspectFit" src="{{logoImage}}" binderror="onLogoError" />
          <view wx:else class="home-brand-mark">
            <view class="home-brand-star">✦</view>
          </view>
        </view>
        <view class="home-brand-copy">
          <view class="home-brand-name">记在星上</view>
          <view class="home-brand-subtitle">星星在闪</view>
        </view>
      </view>

      <view class="home-hero-copy">
        <view class="hero-title">{{content.home_title}}</view>
        <view class="subtitle home-hero-subtitle">{{content.home_subtitle}}</view>
        <view class="home-hero-actions">
          <button class="btn home-primary-cta" bindtap="goProducts">选择一颗星贴</button>
          <button class="btn secondary home-scan-link" bindtap="scanCode">已有星贴？扫码记录</button>
        </view>
        <view class="home-hero-note">星贴贴在酒瓶或礼盒上，不含酒水</view>
      </view>
    </view>
  </view>

  <view class="home-section home-steps-section">
    <view class="home-section-title">把一段记忆，留在这瓶酒里</view>
    <view class="home-steps">
      <view class="home-step">
        <view class="home-step-index">01</view>
        <view class="home-step-icon">贴</view>
        <view class="home-step-title">贴上星贴</view>
        <view class="home-step-desc">贴在酒瓶、礼盒或想留住记忆的物品上</view>
      </view>
      <view class="home-step-connector"></view>
      <view class="home-step">
        <view class="home-step-index">02</view>
        <view class="home-step-icon">扫</view>
        <view class="home-step-title">扫码记录</view>
        <view class="home-step-desc">选一张照片，写下一句话</view>
      </view>
      <view class="home-step-connector"></view>
      <view class="home-step">
        <view class="home-step-index">03</view>
        <view class="home-step-icon">见</view>
        <view class="home-step-title">重新看见</view>
        <view class="home-step-desc">以后再次扫码，回到这一刻</view>
      </view>
    </view>
  </view>

  <view class="home-section home-scene-section">
    <view class="home-section-title">这些时刻，适合留下一颗星</view>
    <scroll-view class="home-scene-scroll" scroll-x="true" enable-flex="true" show-scrollbar="false">
      <view class="home-scene-list">
        <view
          wx:for="{{sceneCards}}"
          wx:key="key"
          class="home-scene-card"
          bindtap="goSceneProducts"
          data-scene="{{item.key}}"
        >
          <image wx:if="{{item.image}}" class="home-scene-image" mode="aspectFill" lazy-load src="{{item.image}}" />
          <view wx:else class="home-scene-fallback">
            <view class="home-scene-symbol">✦</view>
          </view>
          <view class="home-scene-copy">
            <view class="home-scene-title">{{item.title}}</view>
            <view class="home-scene-desc">{{item.description}}</view>
            <view class="home-scene-action">{{item.button_text}}</view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="home-section home-memory-section">
    <view class="home-section-title">一张照片，一句话，就能留下</view>
    <view class="home-section-caption">以下内容为产品使用示意</view>
    <scroll-view class="home-memory-scroll" scroll-x="true" enable-flex="true" show-scrollbar="false">
      <view class="home-memory-list">
        <view
          wx:for="{{slides}}"
          wx:key="title"
          class="home-memory-card"
          bindtap="handleSlideAction"
          data-action="{{item.action_type}}"
          data-scene="{{item.scene_key}}"
        >
          <image wx:if="{{item.image}}" class="home-slide-image home-memory-image" mode="aspectFill" lazy-load src="{{item.image}}" />
          <view wx:else class="home-slide-fallback home-memory-fallback">
            <view class="home-slide-symbol">✦</view>
          </view>
          <view class="home-memory-copy">
            <view class="home-memory-title">{{item.title}}</view>
            <view class="home-memory-desc">{{item.subtitle}}</view>
            <view class="home-memory-action">{{item.button_text}}</view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="home-section home-trust-section">
    <view class="home-section-title">安静保存，也经得起验证</view>
    <view class="home-trust-list">
      <view class="home-trust-item">
        <view class="home-trust-icon">号</view>
        <view class="home-trust-copy">
          <view class="home-trust-label">专属星贴编号</view>
          <view class="home-trust-desc">每颗星贴都有自己的记录编号</view>
        </view>
      </view>
      <view class="home-trust-item">
        <view class="home-trust-icon">存</view>
        <view class="home-trust-copy">
          <view class="home-trust-label">内容安全保存</view>
          <view class="home-trust-desc">照片和文字妥善留存</view>
        </view>
      </view>
      <view class="home-trust-item">
        <view class="home-trust-icon">验</view>
        <view class="home-trust-copy">
          <view class="home-trust-label">保存结果可以验证</view>
          <view class="home-trust-desc">需要时可查看区块链存证凭证</view>
        </view>
      </view>
    </view>
  </view>
</view>
