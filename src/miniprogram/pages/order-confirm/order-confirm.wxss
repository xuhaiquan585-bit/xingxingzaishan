@import "../../styles/dawn.wxss";

.order-confirm-page {
  padding-bottom: calc(190rpx + env(safe-area-inset-bottom));
}

.order-heading {
  margin-bottom: 32rpx;
}

.order-product,
.order-section {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  margin-bottom: 24rpx;
  padding: 24rpx;
  border: 1rpx solid #e2e2de;
  border-radius: 16rpx;
  background: #fff;
}

.order-cover {
  flex: 0 0 176rpx;
  width: 176rpx;
  height: 176rpx;
  border-radius: 12rpx;
  background: #eef1ef;
}

.order-cover-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #b4873d;
  font-family: "Songti SC", STSong, serif;
  font-size: 32rpx;
}

.order-product-copy {
  min-width: 0;
  padding-left: 24rpx;
}

.order-product-title {
  color: #142844;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.4;
}

.order-product-subtitle,
.order-product-meta {
  margin-top: 8rpx;
  color: #728093;
  font-size: 23rpx;
  line-height: 1.45;
}

.order-product-price {
  margin-top: 14rpx;
  color: #a9782e;
  font-size: 30rpx;
  font-weight: 800;
}

.order-section {
  display: block;
}

.order-section-title {
  color: #142844;
  font-size: 29rpx;
  font-weight: 700;
}

.order-field {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  border-bottom: 1rpx solid #ecece8;
}

.order-field:last-child {
  border-bottom: 0;
}

.order-field-column {
  display: block;
  padding: 24rpx 0 12rpx;
}

.order-label {
  flex: 0 0 140rpx;
  color: #26394f;
  font-size: 25rpx;
}

.order-input,
.order-picker-value {
  flex: 1;
  min-width: 0;
  color: #142844;
  font-size: 26rpx;
  text-align: right;
}

.order-picker-value.is-placeholder,
.order-input::placeholder,
.order-textarea::placeholder {
  color: #a5adb5;
}

.order-textarea {
  box-sizing: border-box;
  width: 100%;
  height: 124rpx;
  padding-top: 18rpx;
  color: #142844;
  font-size: 26rpx;
  line-height: 1.55;
}

.order-textarea-short {
  height: 90rpx;
}

.order-quantity-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-quantity-hint {
  margin-top: 8rpx;
  color: #82909f;
  font-size: 22rpx;
}

.quantity-stepper {
  display: flex;
  align-items: center;
  flex: 0 0 auto;
  overflow: hidden;
  border: 1rpx solid #dde1df;
  border-radius: 12rpx;
  background: #fff;
}

.quantity-button {
  display: flex;
  flex: 0 0 72rpx;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  background: #f2f1ed;
  color: #142844;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1;
}

.quantity-button-hover {
  background: #e7e5de;
}

.quantity-button.is-disabled {
  background: #f7f6f3;
  color: #c4c8cb;
}

.quantity-input {
  box-sizing: border-box;
  flex: 0 0 88rpx;
  width: 88rpx;
  height: 72rpx;
  border-right: 1rpx solid #e2e4e2;
  border-left: 1rpx solid #e2e4e2;
  background: #fff;
  color: #142844;
  font-size: 25rpx;
  font-weight: 600;
  text-align: center;
}

.order-state {
  margin-top: 24rpx;
}

.order-pay-bar {
  position: fixed;
  z-index: 10;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-sizing: border-box;
  min-height: 128rpx;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e2e2de;
  background: rgba(252, 251, 248, .98);
}

.order-pay-total {
  flex: 1;
  min-width: 0;
}

.order-pay-label {
  margin-right: 10rpx;
  color: #68788c;
  font-size: 23rpx;
}

.order-pay-amount {
  color: #a9782e;
  font-size: 36rpx;
  font-weight: 800;
}

.order-pay-button {
  width: 300rpx;
}

@media (max-width: 340px) {
  .order-cover {
    flex-basis: 148rpx;
    width: 148rpx;
    height: 148rpx;
  }

  .order-pay-button {
    width: 260rpx;
  }
}
