<view class="dawn-page order-confirm-page">
  <view class="order-heading">
    <view class="dawn-title">确认订单</view>
    <view class="dawn-subtitle">确认星贴与收货信息，完成后等待它寄到你身边。</view>
  </view>

  <block wx:if="{{product}}">
    <view class="order-product">
      <image wx:if="{{product.cover_image && !coverFailed}}" class="order-cover" mode="aspectFill" src="{{product.cover_image}}" binderror="onCoverError" />
      <view wx:else class="order-cover order-cover-fallback">星贴</view>
      <view class="order-product-copy">
        <view class="order-product-title">{{product.title}}</view>
        <view class="order-product-subtitle">{{product.subtitle}}</view>
        <view class="order-product-meta">{{product.sticker_count}} 枚 · 不含酒水</view>
        <view class="order-product-price">{{product.price_text}}</view>
      </view>
    </view>

    <view class="order-section">
      <view class="order-section-title">收货信息</view>
      <label class="order-field">
        <text class="order-label">收货人</text>
        <input class="order-input" placeholder="请输入姓名" data-field="receiverName" bindinput="onInput" />
      </label>
      <label class="order-field">
        <text class="order-label">手机号</text>
        <input class="order-input" placeholder="用于配送联系" type="number" maxlength="11" data-field="receiverPhone" bindinput="onInput" />
      </label>
      <picker mode="region" bindchange="onRegionChange">
        <view class="order-field order-picker">
          <text class="order-label">所在地区</text>
          <text class="order-picker-value {{region ? '' : 'is-placeholder'}}">{{region || '请选择省市区'}}</text>
        </view>
      </picker>
      <label class="order-field order-field-column">
        <text class="order-label">详细地址</text>
        <textarea class="order-textarea" placeholder="街道、门牌号等" data-field="address" bindinput="onInput"></textarea>
      </label>
      <label class="order-field order-field-column">
        <text class="order-label">订单备注</text>
        <textarea class="order-textarea order-textarea-short" placeholder="选填" data-field="remark" bindinput="onInput"></textarea>
      </label>
    </view>

    <view class="order-section order-quantity-row">
      <view>
        <view class="order-section-title">购买数量</view>
        <view class="order-quantity-hint">
          <text>每份含 {{product.sticker_count}} 枚星贴</text>
          <text wx:if="{{product.stock > 0}}"> · 每单最多 {{quantityLimit}} 份</text>
          <text> · 可售 {{product.inventory_count}} 份</text>
        </view>
      </view>
      <view class="quantity-stepper">
        <view
          class="quantity-button {{quantity <= 1 ? 'is-disabled' : ''}}"
          data-delta="-1"
          bindtap="changeQuantity"
          hover-class="quantity-button-hover"
          aria-role="button"
          aria-label="减少商品数量"
          aria-disabled="{{quantity <= 1}}"
        >-</view>
        <input class="quantity-input" type="number" value="{{quantityInput}}" bindfocus="onQuantityFocus" bindinput="onQuantityInput" bindblur="onQuantityBlur" />
        <view
          class="quantity-button {{quantity >= quantityLimit ? 'is-disabled' : ''}}"
          data-delta="1"
          bindtap="changeQuantity"
          hover-class="quantity-button-hover"
          aria-role="button"
          aria-label="增加商品数量"
          aria-disabled="{{quantity >= quantityLimit}}"
        >+</view>
      </view>
    </view>
  </block>

  <view wx:if="{{message}}" class="dawn-state order-state">{{message}}</view>

  <view wx:if="{{product}}" class="order-pay-bar">
    <view class="order-pay-total">
      <text class="order-pay-label">实付</text>
      <text class="order-pay-amount">{{totalText}}</text>
    </view>
    <button class="dawn-primary-button order-pay-button" bindtap="submitOrder" loading="{{submitting}}" disabled="{{submitting || quantityLimit <= 0}}">{{quantityLimit <= 0 ? '已售罄' : (submitting ? '处理中' : '立即支付')}}</button>
  </view>
</view>
