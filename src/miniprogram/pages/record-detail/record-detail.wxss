@import "../../styles/dawn.wxss";

.record-detail-page {
  padding-top: 34rpx;
}

.detail-hero {
  padding: 4rpx 0 28rpx;
}

.detail-content {
  position: relative;
}

.detail-image {
  display: block;
  width: 100%;
  margin-bottom: 22rpx;
  border-radius: 16rpx;
  background: #ecefe9;
}

.memory-content {
  padding: 26rpx 2rpx 30rpx;
  border-bottom: 1rpx solid #e1e4e3;
  color: #263445;
  font-family: "Songti SC", STSong, serif;
  font-size: 33rpx;
  line-height: 1.78;
  overflow-wrap: break-word;
}

.detail-info-group {
  padding: 28rpx 0;
  border-bottom: 1rpx solid #e1e4e3;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  gap: 22rpx;
  font-size: 23rpx;
  line-height: 1.55;
}

.detail-row + .detail-row {
  margin-top: 14rpx;
}

.detail-label {
  color: #8b969f;
  font-size: 22rpx;
}

.detail-value {
  color: #526576;
  text-align: right;
}

.mono,
.hash {
  font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
}

.detail-section,
.verification-section {
  padding: 34rpx 0;
  border-bottom: 1rpx solid #e1e4e3;
}

.comment-item {
  margin-top: 18rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #e1e4e3;
  border-radius: 16rpx;
  background: #fff;
}

.comment-author {
  color: #a77d37;
  font-size: 21rpx;
  font-weight: 700;
}

.comment-content {
  margin-top: 7rpx;
  color: #526576;
  font-size: 25rpx;
  line-height: 1.65;
}

.brand-disclosure-line {
  margin-top: 26rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  background: #ecefe9;
  color: #68788c;
  font-size: 23rpx;
  line-height: 1.6;
}

.brand-disclosure-line .detail-label {
  margin-bottom: 7rpx;
}

.verification-heading {
  color: #263445;
  font-size: 27rpx;
  font-weight: 700;
}

.verification-copy {
  margin-top: 7rpx;
  color: #7a8794;
  font-size: 22rpx;
  line-height: 1.55;
}

.hash-card {
  margin-top: 20rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #e1e4e3;
  border-radius: 16rpx;
  background: #fff;
}

.hash {
  margin-top: 9rpx;
  color: #526576;
  font-size: 22rpx;
  line-height: 1.65;
  overflow-wrap: anywhere;
}

.hash-expanded {
  word-break: break-all;
}

.hash-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 14rpx;
}

.hash-action,
.certificate-link {
  margin: 0;
  padding: 0;
  background: transparent;
  color: #a77d37;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.5;
  text-align: left;
}

.hash-action::after,
.certificate-link::after {
  border: 0;
}

.certificate-link {
  margin-top: 20rpx;
}

.detail-back-btn {
  width: 100%;
  margin-top: 32rpx;
}

.detail-state {
  margin-top: 20rpx;
}

@media (max-width: 340px) {
  .detail-row {
    flex-direction: column;
    gap: 5rpx;
  }

  .detail-value {
    text-align: left;
  }
}
