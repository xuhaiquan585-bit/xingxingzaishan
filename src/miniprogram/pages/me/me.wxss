@import "../../styles/dawn.wxss";

.me-page {
  padding-top: 34rpx;
}

.me-hero {
  padding: 4rpx 0 28rpx;
}

.me-account-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 22rpx 0;
  border-top: 1rpx solid #e1e4e3;
  border-bottom: 1rpx solid #e1e4e3;
}

.me-account-label,
.me-stat-label,
.me-record-count {
  color: #8b969f;
  font-size: 21rpx;
  line-height: 1.4;
}

.me-account-phone {
  margin-top: 5rpx;
  color: #263445;
  font-size: 27rpx;
  font-weight: 700;
}

.me-phone-change {
  flex: 0 0 auto;
  color: #a77d37;
  font-size: 23rpx;
  font-weight: 700;
}

.me-stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin: 26rpx 0;
  border: 1rpx solid #e1e4e3;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, .76);
}

.me-stat {
  min-width: 0;
  padding: 24rpx 10rpx;
  text-align: center;
}

.me-stat + .me-stat {
  border-left: 1rpx solid #e1e4e3;
}

.me-stat-value {
  color: #142844;
  font-family: "Songti SC", STSong, serif;
  font-size: 34rpx;
  font-weight: 700;
}

.me-stat-label {
  margin-top: 5rpx;
}

.me-order-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  width: 100%;
  min-height: 104rpx;
  margin: 0;
  padding: 20rpx 22rpx;
  border: 1rpx solid #e1e4e3;
  border-radius: 16rpx;
  background: #fff;
  color: #263445;
  line-height: 1.3;
  text-align: left;
}

.me-order-entry::after {
  border: 0;
}

.me-entry-title {
  font-size: 27rpx;
  font-weight: 700;
}

.me-entry-copy {
  margin-top: 7rpx;
  color: #7a8794;
  font-size: 21rpx;
}

.me-entry-arrow {
  color: #a77d37;
  font-size: 40rpx;
  font-weight: 400;
}

.me-record-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 42rpx;
}

.me-filters {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8rpx;
  margin: 20rpx 0 22rpx;
  padding: 6rpx;
  border-radius: 14rpx;
  background: #e9ece9;
}

.me-filter {
  min-width: 0;
  padding: 15rpx 8rpx;
  border-radius: 10rpx;
  color: #68788c;
  font-size: 23rpx;
  font-weight: 600;
  text-align: center;
}

.me-filter.active {
  background: #fff;
  color: #142844;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.record-card {
  overflow: hidden;
}

.record-cover {
  display: block;
  width: 100%;
  height: 360rpx;
  border-radius: 0;
  background: #ecefe9;
}

.record-cover-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8b969f;
  font-size: 22rpx;
}

.record-copy {
  padding: 22rpx;
}

.record-status {
  display: inline-flex;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  background: #f1e5cd;
  color: #946d2f;
  font-size: 19rpx;
  font-weight: 700;
}

.record-summary {
  display: -webkit-box;
  margin-top: 14rpx;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  color: #263445;
  font-family: "Songti SC", STSong, serif;
  font-size: 29rpx;
  line-height: 1.58;
}

.record-meta-group {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 14rpx;
  color: #7a8794;
  font-size: 21rpx;
  line-height: 1.45;
}

.mono {
  font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
}

.record-action {
  margin-top: 16rpx;
  color: #a77d37;
  font-size: 23rpx;
  font-weight: 700;
}

.me-empty,
.me-state {
  margin-top: 22rpx;
}

.me-empty-title {
  color: #263445;
  font-size: 27rpx;
  font-weight: 700;
}

.me-empty-copy {
  margin-top: 8rpx;
}

.me-empty-action {
  min-height: 76rpx;
  margin-top: 22rpx;
  font-size: 25rpx;
}

@media (max-width: 340px) {
  .record-meta-group {
    flex-direction: column;
    gap: 6rpx;
  }
}
