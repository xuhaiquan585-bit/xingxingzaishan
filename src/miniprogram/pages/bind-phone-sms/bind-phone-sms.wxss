.bind-phone-sms-page {
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 96rpx 44rpx calc(72rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(
      circle at 90% 6%,
      rgba(255, 243, 216, .16) 0%,
      rgba(255, 243, 216, .05) 24%,
      rgba(255, 243, 216, 0) 44%
    ),
    linear-gradient(
      180deg,
      #D8E4EA 0%,
      #E8EEF0 38%,
      #F0F1ED 70%,
      #F5F1E9 100%
    );
  color: #223147;
}

.bind-phone-sms-page::before,
.bind-phone-sms-page::after {
  display: none;
}

.bind-phone-sms-page .bind-brand {
  margin: 0 0 42rpx;
  text-align: left;
}

.bind-phone-sms-page .bind-brand-mark {
  display: none;
}

.bind-phone-sms-page .hero-title {
  max-width: 100%;
  margin: 0 0 16rpx;
  color: #223147;
  font-size: 44rpx;
  font-weight: 650;
  line-height: 1.34;
  text-align: left;
}

.bind-phone-sms-page .subtitle {
  max-width: 100%;
  margin: 0;
  color: #68798A;
  font-size: 27rpx;
  line-height: 1.62;
  text-align: left;
}

.bind-phone-sms-page .bind-subtitle {
  white-space: pre-line;
}

.sms-bind-card {
  box-sizing: border-box;
  width: 100%;
  margin: 0;
  padding: 30rpx 28rpx 32rpx;
  border: 1rpx solid rgba(52, 72, 91, .12);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, .62);
  box-shadow: none;
  -webkit-backdrop-filter: none;
  backdrop-filter: none;
}

.sms-field {
  margin: 0 0 30rpx;
}

.sms-label {
  margin: 0 0 12rpx;
  color: #526576;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.35;
}

.sms-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 96rpx;
  padding: 0 28rpx;
  border: 1rpx solid rgba(34, 49, 71, .14);
  border-radius: 16rpx;
  background: rgba(248, 250, 251, .76);
  color: #223147;
  font-size: 30rpx;
  line-height: 1;
  box-shadow: none;
}

.sms-input[disabled] {
  color: #8493A1;
  opacity: 1;
}

.sms-placeholder {
  color: #8C98A4;
}

.sms-code-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 184rpx;
  column-gap: 12rpx;
  align-items: stretch;
}

.sms-code-input {
  min-width: 0;
}

.sms-code-btn {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 96rpx;
  margin: 0;
  padding: 0 14rpx;
  border: 1rpx solid rgba(168, 137, 85, .24);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, .3);
  color: #A88955;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
  white-space: nowrap;
  box-shadow: none;
}

.sms-code-btn::after,
.sms-submit-btn::after {
  border: 0;
}

.sms-code-btn[disabled] {
  color: #8493A1;
  opacity: 1;
}

.sms-submit-btn {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 100rpx;
  margin: 38rpx 0 0;
  padding: 0 36rpx;
  border-radius: 16rpx;
  background: #C79E55;
  color: #162230;
  font-size: 30rpx;
  font-weight: 650;
  line-height: 1;
  white-space: nowrap;
  box-shadow: none;
}

.sms-submit-btn[disabled] {
  background: #E7D8B8;
  color: #7F786B;
  opacity: 1;
}

.bind-phone-sms-page .meta {
  box-sizing: border-box;
  margin: 24rpx 0 0;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(164, 95, 89, .16);
  border-radius: 16rpx;
  background: rgba(164, 95, 89, .06);
  color: #A45F59;
  font-size: 24rpx;
  line-height: 1.58;
  text-align: left;
}
