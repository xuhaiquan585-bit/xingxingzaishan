.bind-phone-sms-page {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 100vh;
  padding-left: 44rpx;
  padding-right: 44rpx;
  padding-bottom: calc(112rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(
      circle at 92% 4%,
      rgba(244, 194, 142, .16),
      transparent 48%
    ),
    linear-gradient(
      180deg,
      #C9D8E6 0%,
      #E2E9ED 42%,
      #F0EEE8 100%
    );
  color: #263445;
}

.bind-phone-sms-page .bind-brand {
  margin-bottom: 64rpx;
  text-align: center;
}

.bind-phone-sms-page .bind-brand-mark {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  margin-bottom: 28rpx;
  border: 1rpx solid rgba(212, 175, 55, .38);
  border-radius: 50%;
  background: rgba(212, 175, 55, .1);
  color: #A88955;
  font-size: 42rpx;
  font-weight: 700;
}

.bind-phone-sms-page .hero-title {
  color: #223147;
  text-align: center;
}

.bind-phone-sms-page .subtitle {
  margin-bottom: 0;
  color: #68798A;
  text-align: center;
}

.bind-phone-sms-page .bind-subtitle {
  white-space: pre-line;
}

.sms-bind-card {
  padding: 38rpx 32rpx 34rpx;
  border: 1px solid rgba(52, 72, 91, .12);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, .58);
  box-shadow: 0 10rpx 30rpx rgba(66, 79, 91, .08);
  -webkit-backdrop-filter: none;
  backdrop-filter: none;
}

.sms-field {
  margin-bottom: 28rpx;
}

.sms-label {
  margin-bottom: 12rpx;
  color: #223147;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
}

.sms-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 92rpx;
  padding: 0 28rpx;
  border: 1rpx solid rgba(52, 72, 91, .12);
  border-radius: 14rpx;
  background: rgba(248, 250, 251, .74);
  color: #223147;
  font-size: 30rpx;
  box-shadow: none;
}

.sms-placeholder {
  color: #8493A1;
}

.sms-code-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 192rpx;
  column-gap: 12rpx;
  align-items: stretch;
}

.sms-code-input {
  min-width: 0;
}

.sms-code-btn {
  box-sizing: border-box;
  min-height: 92rpx;
  margin: 0;
  padding: 0 18rpx;
  border: 1rpx solid rgba(158, 128, 80, .26);
  border-radius: 14rpx;
  background: rgba(255, 255, 255, .32);
  color: #9E8050;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
  white-space: nowrap;
  box-shadow: none;
}

.sms-code-btn::after,
.sms-submit-btn::after {
  border: 0;
}

.sms-code-btn[disabled] {
  color: #8493A1;
  opacity: .58;
}

.sms-submit-btn {
  box-sizing: border-box;
  width: 460rpx;
  max-width: 100%;
  min-height: 96rpx;
  margin: 34rpx auto 0;
  padding: 0 42rpx;
  border-radius: 14rpx;
  background: #C79E55;
  color: #162230;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
  box-shadow: none;
}

.sms-submit-btn[disabled] {
  background: rgba(199, 158, 85, .34);
  color: rgba(22, 34, 48, .48);
  opacity: 1;
}

.bind-phone-sms-page .meta {
  margin-top: 20rpx;
  min-height: 40rpx;
  color: #A45F58;
  text-align: center;
}
