<view class="page dawn-page products-page">
  <view class="products-hero">
    <view class="dawn-eyebrow">为值得记住的时刻</view>
    <view class="dawn-title">选择一颗适合这一刻的星贴</view>
    <view class="dawn-subtitle">按想留下的时刻挑选。星贴是记录入口，不含酒水。</view>
  </view>

  <scroll-view class="scene-tabs" scroll-x="true" enable-flex="true" show-scrollbar="false">
    <view class="scene-tab-list">
      <view
        wx:for="{{sceneOptions}}"
        wx:key="key"
        class="scene-tab {{activeScene === item.key ? 'active' : ''}}"
        bindtap="changeScene"
        data-scene="{{item.key}}"
      >{{item.label}}</view>
    </view>
  </scroll-view>

  <view class="products-heading">
    <view>
      <view class="dawn-section-title">为「{{activeSceneLabel}}」挑选</view>
      <view class="products-note">每颗星贴都能保存一张照片和一句话</view>
    </view>
    <view class="products-count" wx:if="{{products.length}}">{{products.length}} 款</view>
  </view>

  <view class="product-list" wx:if="{{products.length}}">
    <view
      wx:for="{{products}}"
      wx:key="id"
      class="dawn-card product-card"
      bindtap="openProduct"
      data-id="{{item.id}}"
    >
      <image
        wx:if="{{item.cover_image && !item.image_failed}}"
        class="product-cover"
        mode="aspectFill"
        lazy-load
        src="{{item.cover_image}}"
        binderror="onProductImageError"
        data-id="{{item.id}}"
      />
      <view wx:else class="product-cover product-cover-fallback">
        <view class="product-fallback-mark">星</view>
        <view class="product-fallback-text">星贴实物图</view>
      </view>
      <view class="product-copy">
        <view class="product-title">{{item.title}}</view>
        <view class="product-subtitle">{{item.subtitle}}</view>
        <view class="product-meta">星贴 {{item.sticker_count}} 枚 · 不含酒水</view>
        <view class="product-footer">
          <view class="product-price">{{item.price_text}}</view>
          <view class="product-action">查看详情</view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{message}}" class="dawn-state products-state">
    <view>{{message}}</view>
    <button wx:if="{{allProducts.length && !products.length}}" class="dawn-secondary-button products-state-action" bindtap="showAllProducts">查看全部星贴</button>
  </view>
</view>
