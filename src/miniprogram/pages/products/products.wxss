@import "../../styles/dawn.wxss";

.products-page {
  padding-top: 34rpx;
}

.products-hero {
  padding: 4rpx 0 28rpx;
}

.products-hero .dawn-title {
  max-width: 610rpx;
}

.scene-tabs {
  width: calc(100% + 56rpx);
  margin-left: -28rpx;
  white-space: nowrap;
}

.scene-tab-list {
  display: flex;
  gap: 12rpx;
  padding: 4rpx 28rpx 10rpx;
}

.scene-tab {
  flex: 0 0 auto;
  box-sizing: border-box;
  min-height: 68rpx;
  padding: 18rpx 26rpx;
  border: 1rpx solid #dfe3e2;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, .72);
  color: #68788c;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.2;
}

.scene-tab.active {
  border-color: rgba(183, 137, 59, .42);
  background: #f1e5cd;
  color: #8e6729;
}

.products-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin: 30rpx 0 22rpx;
}

.products-note {
  margin-top: 8rpx;
  color: #7a8794;
  font-size: 22rpx;
  line-height: 1.45;
}

.products-count {
  flex: 0 0 auto;
  padding-bottom: 4rpx;
  color: #8b969f;
  font-size: 22rpx;
}

.product-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.product-card {
  min-width: 0;
  overflow: hidden;
}

.product-cover {
  display: block;
  width: 100%;
  height: 300rpx;
  border-radius: 0;
  background: #eef1ed;
}

.product-cover-fallback {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: #ecefe9;
}

.product-fallback-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border: 1rpx solid rgba(183, 137, 59, .3);
  border-radius: 50%;
  color: #a77d37;
  font-family: "Songti SC", STSong, serif;
  font-size: 27rpx;
}

.product-fallback-text {
  color: #8b969f;
  font-size: 20rpx;
}

.product-copy {
  padding: 20rpx;
}

.product-title {
  color: #142844;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.38;
}

.product-subtitle {
  display: -webkit-box;
  min-height: 66rpx;
  margin-top: 8rpx;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  color: #68788c;
  font-size: 22rpx;
  line-height: 1.5;
}

.product-meta {
  margin-top: 12rpx;
  color: #8b969f;
  font-size: 20rpx;
  line-height: 1.45;
}

.product-stock {
  margin-top: 10rpx;
  color: #607067;
  font-size: 22rpx;
}

.product-stock.is-sold-out {
  color: #a9483d;
  font-weight: 600;
}

.product-footer {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 18rpx;
}

.product-price {
  color: #a77d37;
  font-size: 29rpx;
  font-weight: 700;
}

.product-action {
  color: #526576;
  font-size: 21rpx;
  font-weight: 600;
}

.products-state {
  margin-top: 24rpx;
}

.products-state-action {
  min-height: 76rpx;
  margin-top: 22rpx;
  font-size: 25rpx;
}

@media (max-width: 340px) {
  .scene-tabs {
    width: calc(100% + 44rpx);
    margin-left: -22rpx;
  }

  .scene-tab-list {
    padding-left: 22rpx;
    padding-right: 22rpx;
  }

  .product-list {
    gap: 14rpx;
  }

  .product-cover {
    height: 272rpx;
  }

  .product-copy {
    padding: 16rpx;
  }
}
